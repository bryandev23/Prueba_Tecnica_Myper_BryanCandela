@model Prueba_Tecnica_Trabajadores.Models.ViewModels.VMTrabajadorCrear

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title"><i class="bi bi-person-plus-fill me-2"></i>Nuevo Trabajador</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="Crear" method="post" enctype="multipart/form-data" onsubmit="return jQueryAjaxPost(this);">
    <div class="modal-body p-4">

        <div id="error-server-msg" class="alert alert-danger text-center shadow-sm" style="display:none; font-size:0.9rem;"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Nombres" class="form-label fw-bold">Nombres</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                    <input asp-for="Nombres" class="form-control" placeholder="Ej. Juan" />
                </div>
                <span asp-validation-for="Nombres" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Apellidos" class="form-label fw-bold">Apellidos</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                    <input asp-for="Apellidos" class="form-control" placeholder="Ej. Pérez" />
                </div>
                <span asp-validation-for="Apellidos" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="DocumentoId" class="form-label fw-bold">Tipo Documento</label>
                <select asp-for="DocumentoId" class="form-select" asp-items="@(new SelectList(ViewBag.Documentos, "Id", "Nombre"))">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="DocumentoId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="NroDocumento" class="form-label fw-bold">Nro Documento</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-card-heading"></i></span>
                    <input asp-for="NroDocumento" class="form-control" placeholder="Ej. 12345678" />
                </div>
                <span asp-validation-for="NroDocumento" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold d-block">Sexo</label>
                <div class="d-flex gap-3 mt-2">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Sexo" value="M" checked>
                        <label class="form-check-label">Masculino</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Sexo" value="F">
                        <label class="form-check-label">Femenino</label>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <label asp-for="FechaNacimiento" class="form-label fw-bold">F. Nacimiento</label>
                <input asp-for="FechaNacimiento" class="form-control" type="date" />
                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Direccion" class="form-label fw-bold">Dirección</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
                    <textarea asp-for="Direccion" class="form-control" rows="2" placeholder="Av. Principal 123"></textarea>
                </div>
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="FotoArchivo" class="form-label fw-bold">Foto de Perfil</label>
                <input asp-for="FotoArchivo" class="form-control" type="file" accept="image/*" />
            </div>
        </div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary px-4">Guardar</button>
    </div>
</form>